{
  "name": "antigravity-quota-monitor",
  "displayName": "Antigravity Quota Monitor & Dashboard",
  "description": "Visual, real-time AI quota monitor with color & white progress bars, reset countdowns, audio alerts and interactive dashboard for Antigravity IDE (Gemini 3.8 Flash, Claude Opus 5.5, Claude Sonnet 5.5, GPT-OSS).",
  "version": "1.4.0",
  "publisher": "Nordicstocks",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#0d1117",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other",
    "Visualization",
    "Programming Languages"
  ],
  "keywords": [
    "antigravity",
    "quota",
    "gemini",
    "claude",
    "rate-limit",
    "usage",
    "dashboard",
    "monitor",
    "limits",
    "speedometer",
    "token-counter",
    "analytics"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Nordicstocks/antigravity-quota-monitor"
  },
  "homepage": "https://github.com/Nordicstocks/antigravity-quota-monitor",
  "bugs": {
    "url": "https://github.com/Nordicstocks/antigravity-quota-monitor/issues"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "antigravityQuota.showDashboard",
        "title": "Antigravity Quota: Open Visual Dashboard / Ava visuaalne dashboard",
        "icon": "$(graph)"
      },
      {
        "command": "antigravityQuota.showMenu",
        "title": "Antigravity Quota: Open Quick Menu / Ava kiirmenüü",
        "icon": "$(dashboard)"
      },
      {
        "command": "antigravityQuota.selectBarStyle",
        "title": "Antigravity Quota: Select Progress Bar Style (Colored or White) / Vali skaala stiil"
      },
      {
        "command": "antigravityQuota.selectDisplayMode",
        "title": "Antigravity Quota: Select Display Mode / Vali kuvamise viis"
      },
      {
        "command": "antigravityQuota.selectLanguage",
        "title": "Antigravity Quota: Select Language / Vali keel"
      },
      {
        "command": "antigravityQuota.refresh",
        "title": "Antigravity Quota: Refresh Now / Värskenda kohe",
        "icon": "$(refresh)"
      },
      {
        "command": "antigravityQuota.enterLicense",
        "title": "Antigravity Quota: Enter Pro License Key / Sisesta Pro litsentsivõti",
        "icon": "$(star)"
      },
      {
        "command": "antigravityQuota.exportCsv",
        "title": "Antigravity Quota: Export Usage History (CSV) / Ekspordi ajalugu"
      },
      {
        "command": "antigravityQuota.exportJson",
        "title": "Antigravity Quota: Export Usage History (JSON)"
      }
    ],
    "configuration": {
      "title": "Antigravity Quota Monitor",
      "properties": {
        "antigravityQuota.language": {
          "type": "string",
          "enum": ["auto", "en", "et", "de", "fi", "es", "fr"],
          "enumDescriptions": [
            "Auto (System Default / Süsteemi keel)",
            "English",
            "Eesti keel",
            "Deutsch",
            "Suomi",
            "Español",
            "Français"
          ],
          "default": "auto",
          "description": "UI language / Kasutajaliidese keel."
        },
        "antigravityQuota.displayMode": {
          "type": "string",
          "enum": ["compact", "lowest", "gemini", "claude"],
          "enumDescriptions": [
            "Compact: G: 64% 🟩🟩🟩⬜⬜ | C: 84% 🟩🟩🟩🟩⬜",
            "Lowest remaining quota model",
            "Gemini models only",
            "Claude models only"
          ],
          "default": "compact",
          "description": "How quota is displayed in the status bar."
        },
        "antigravityQuota.barStyle": {
          "type": "string",
          "enum": [
            "emoji-blocks",
            "emoji-dots",
            "emoji-diamonds",
            "blocks",
            "squares",
            "parallelograms",
            "dots",
            "shades"
          ],
          "enumDescriptions": [
            "🟩 Värvilised klotsid: 🟩🟩🟩⬜⬜ (Roheline / Kollane / Punane)",
            "🟢 Värvilised täpid: 🟢🟢🟢⚪⚪",
            "🔷 Värvilised teemandid: 🔷🔷🔷◽◽",
            "█ Valged plokid: [████░] (Minimalistlik valge)",
            "■ Valged ruudud: [■■■■□]",
            "▰ Valged rööpkülikud: ▰▰▰▱",
            "● Valged täpid: ●●●○○",
            "▓ Valged varjundid: [▓▓▓▓░]"
          ],
          "default": "emoji-blocks",
          "description": "Visual progress bar style (both colored scales and clean white styles available)."
        },
        "antigravityQuota.enableAudioAlerts": {
          "type": "boolean",
          "default": true,
          "description": "Mängi heliteavitust kui kvoot saab 100% täis või kukub alla 10% (Play audio chime on 100% refill & low quota)."
        },
        "antigravityQuota.autoFallbackEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Soovita automaatselt varumudelit kui aktiivne kvoot langeb alla 5%."
        },
        "antigravityQuota.fallbackTargetModel": {
          "type": "string",
          "default": "gemini-3.8-flash-high",
          "description": "Mudel, millele lülitutakse automaatselt üle kui aktiivse mudeli limiit on otsakorral."
        },
        "antigravityQuota.pollingInterval": {
          "type": "number",
          "default": 60,
          "description": "Refresh interval in seconds (minimum 15s)."
        },
        "antigravityQuota.warnThreshold": {
          "type": "number",
          "default": 30,
          "description": "Warning threshold percentage (yellow indicator)."
        },
        "antigravityQuota.criticalThreshold": {
          "type": "number",
          "default": 15,
          "description": "Critical threshold percentage (red indicator)."
        }
      }
    }
  }
}
